# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

ANTHROPIC_API_KEY=your_key_here

# Optional — get a free key at https://openweathermap.org/api
# If absent, the agent averages NWS + Open-Meteo only (US locations still work).
OPENWEATHERMAP_API_KEY=

# Gmail (primary test channel for --channel email)
# SMTP_PASS must be a Gmail App Password (NOT your regular password).
# Enable 2-Step Verification at myaccount.google.com, then generate an
# App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ALERT_TO=safety@company.com

# To switch to Outlook/Microsoft 365 later:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   (also change SMTP_SSL → SMTP + starttls() in send_alert)

# To switch to Teams: add TEAMS_WEBHOOK_URL and use --channel teams
# (requires a one-line addition to send_alert in weather_alert_agent.py)

# Slack incoming webhook URL (for --channel slack)
SLACK_WEBHOOK_URL=
